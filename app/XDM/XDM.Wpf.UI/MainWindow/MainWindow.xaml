<Window x:Class="XDM.Wpf.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        mc:Ignorable="d"
        Title="Xtreme Download Manager" Height="620" Width="980"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}">
    <Window.Resources>
        <ContextMenu x:Key="ctxMainMenu" x:Name="ctxMainMenu" LayoutUpdated="ctxMainMenu_LayoutUpdated">
            <MenuItem Name="menuSettings" Header="{StaticResource TITLE_SETTINGS}" Foreground="{StaticResource ControlForecolor}" Click="menuSettings_Click"/>
            <MenuItem Name="menuBrowserMonitor" Header="{StaticResource SETTINGS_MONITORING}" Click="menuBrowserMonitor_Click" Foreground="{StaticResource ControlForecolor}"/>
            <MenuItem Name="menuMediaGrabber" Header="{StaticResource MSG_MEDIA_CAPTURE}" Click="menuMediaGrabber_Click" Foreground="{StaticResource ControlForecolor}"/>
            <MenuItem Name="menuClearFinished" Header="{StaticResource MENU_DELETE_COMPLETED}" Click="menuClearFinished_Click" Foreground="{StaticResource ControlForecolor}"/>
            <MenuItem Name="menuExport" Header="{StaticResource MENU_EXPORT}" Click="menuExport_Click" Foreground="{StaticResource ControlForecolor}"/>
            <MenuItem Name="menuImport" Header="{StaticResource MENU_IMPORT}" Click="menuImport_Click" Foreground="{StaticResource ControlForecolor}"/>
            <MenuItem Name="menuLanguage" Header="{StaticResource MENU_LANG}" Foreground="{StaticResource ControlForecolor}" Click="menuLanguage_Click"/>
            <MenuItem Name="menuHelpAndSupport" Header="{StaticResource LBL_SUPPORT_PAGE}" Click="menuHelpAndSupport_Click" Foreground="{StaticResource ControlForecolor}"/>
            <MenuItem Name="menuReportProblem" Header="{StaticResource LBL_REPORT_PROBLEM}" Click="menuReportProblem_Click" Foreground="{StaticResource ControlForecolor}"/>
            <MenuItem Name="menuCheckForUpdate" Header="{StaticResource MENU_UPDATE}" Click="menuCheckForUpdate_Click" Foreground="{StaticResource ControlForecolor}"/>
            <MenuItem Name="menuAbout" Header="{StaticResource MENU_ABOUT}" Click="menuAbout_Click" Foreground="{StaticResource ControlForecolor}"/>
            <MenuItem Name="menuExit" Header="{StaticResource MENU_EXIT}" Foreground="{StaticResource ControlForecolor}" Click="menuExit_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="lvInProgressContextMenu"></ContextMenu>
        <ContextMenu x:Key="lvFinishedContextMenu"></ContextMenu>
        <ContextMenu x:Key="newDownloadContextMenu">
            <MenuItem Name="menuNewDownload" Foreground="{StaticResource ControlForecolor}"/>
            <MenuItem Name="menuVideoDownload" Foreground="{StaticResource ControlForecolor}"/>
            <MenuItem Name="menuBatchDownload" Foreground="{StaticResource ControlForecolor}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--#region Sidebar (macOS / Arc Browser Inspired) -->
        <Border Grid.Column="0" Background="{StaticResource CategoryListBackground}"
                BorderBrush="{StaticResource ToolbarBordercolor}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- App Header Logo / Title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,16">
                    <Border CornerRadius="8" Width="32" Height="32" Background="{StaticResource AccentGradientBrush}" Margin="0,0,12,0">
                        <Path Data="{StaticResource ri-file-download-fill}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="XDM" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CategoryForegroundSelected}"/>
                        <TextBlock Text="Download Manager" FontSize="11" Foreground="{StaticResource CategoryForegroundNormal}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Categories List -->
                <ListBox Grid.Row="1" Name="lvCategory"
                         SelectionChanged="lvCategory_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         Margin="8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                      StrokeThickness="0" Stretch="Uniform"
                                      Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}, Path=Tag}"
                                      Width="18" Height="18"
                                      Data="{Binding Path=VectorIcon, Converter={StaticResource CategoryToVectorImageConverter}}"
                                      SnapsToDevicePixels="True"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}, Path=Tag}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region Main Content View -->
        <DockPanel Grid.Column="1" Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}">
            <!-- Top Toolbar & Search Bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource ControlBackcolor}"
                    BorderBrush="{StaticResource ToolbarBordercolor}" BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="BtnNew" Style="{StaticResource AccentButton}" Padding="14,7" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ri-links-line}" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{StaticResource DESC_NEW}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnPause" Padding="12,7" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ri-pause-line}" Fill="{StaticResource ToolButtonForecolor}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{StaticResource MENU_PAUSE}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnResume" Padding="12,7" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ri-play-line}" Fill="{StaticResource ToolButtonForecolor}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{StaticResource MENU_RESUME}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnOpenFolder" Padding="12,7" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ri-folder-shared-line}" Fill="{StaticResource ToolButtonForecolor}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{StaticResource CTX_OPEN_FOLDER}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnOpen" Visibility="Collapsed" Padding="12,7" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ri-mail-open-line}" Fill="{StaticResource ToolButtonForecolor}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{StaticResource CTX_OPEN_FILE}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnDelete" Padding="12,7" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ri-delete-bin-line}" Fill="{StaticResource ToolButtonForecolor}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{StaticResource DESC_DEL}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Search Box & Menu -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SearchBackcolor}" BorderBrush="{StaticResource SearchBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="0,0,8,0" Width="180">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Name="TxtSearch" AcceptsReturn="False" TextWrapping="NoWrap"
                                         VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                         Padding="4,2" Foreground="{StaticResource TextForecolor}"/>
                                <TextBlock Grid.Column="0" x:Name="Placeholder" IsHitTestVisible="False"
                                           Text="{StaticResource LBL_SEARCH}" VerticalAlignment="Center" Margin="6,0"
                                           Foreground="{StaticResource PlaceHolderForecolor}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsFocused, ElementName=TxtSearch}" Value="false" />
                                                        <Condition Binding="{Binding Text, ElementName=TxtSearch}" Value="" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.Setters>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger.Setters>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Padding="4" Margin="0" Background="Transparent" BorderThickness="0" Click="SearchButton_Click">
                                    <Path Data="{StaticResource ri-search-line}" Fill="{StaticResource ToolButtonForecolor}" Stretch="Uniform" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Button Name="BtnMenu" Padding="8" Background="Transparent" BorderThickness="0" Click="BtnMenu_Click">
                            <Path Data="{StaticResource ri-menu-line}" Fill="{StaticResource ToolButtonForecolor}" Stretch="Uniform" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Footer Status Bar -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource StatusbarBackcolor}"
                    BorderBrush="{StaticResource ToolbarBordercolor}" BorderThickness="0,1,0,0" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{StaticResource SETTINGS_MONITORING}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource ToolButtonForecolor}" FontSize="12"/>
                    <Button Grid.Column="1" Name="BtnMonitoring" Background="Transparent" BorderThickness="0" Padding="0" Click="BtnMonitoring_Click">
                        <Path Name="MonitoringToggleIcon" Data="{StaticResource ri-toggle-line}" Fill="{StaticResource StatusbarIconcolor}" Stretch="Uniform" Width="20" Height="20"/>
                    </Button>

                    <Button Grid.Column="2" Name="BtnQueue" Background="Transparent" BorderThickness="0" Margin="20,0,0,0" Padding="0" Click="BtnQueue_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ri-list-settings-fill}" Fill="{StaticResource StatusbarIconcolor}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{StaticResource DESC_Q_TITLE}" VerticalAlignment="Center" Foreground="{StaticResource ToolButtonForecolor}" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Name="BtnHelp" Background="Transparent" BorderThickness="0" Padding="0" Click="BtnHelp_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Name="PathHelp" Data="{StaticResource ri-question-line}" Fill="{StaticResource StatusbarIconcolor}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Name="TxtHelp" Text="{StaticResource LBL_SUPPORT_PAGE}" VerticalAlignment="Center" Foreground="{StaticResource ToolButtonForecolor}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Download List Views (Cards Layout) -->
            <Grid Margin="12,10">
                <ListView Name="lvInProgress" BorderThickness="0" Background="Transparent"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          GridViewColumnHeader.Click="lvInProgress_Click">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="320">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Name">
                                        <TextBlock Text="{StaticResource SORT_NAME}"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                            <Border CornerRadius="6" Width="30" Height="30" Background="{StaticResource CategoryHighlight}" Margin="0,0,10,0">
                                                <Path Data="{Binding Path=Name, Converter={StaticResource FileExtensionToVectorImageConverter}}"
                                                      Fill="{StaticResource ListViewIconForecolor}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="110">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="DateAdded" Name="lvInProgress_DateAdded">
                                        <TextBlock Text="{StaticResource SORT_DATE}"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DateAdded, StringFormat=d}" VerticalAlignment="Center" Foreground="{StaticResource ListViewHeaderForecolor}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="90" DisplayMemberBinding="{Binding Size, Converter={StaticResource FileSizeValueConverter}}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Size">
                                        <TextBlock Text="{StaticResource SORT_SIZE}"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                            </GridViewColumn>

                            <GridViewColumn Header="%" Width="120" x:Name="p1">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="{StaticResource SORT_STATUS}" Width="160" DisplayMemberBinding="{Binding StatusText}"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="ContextMenu" Value="{StaticResource lvInProgressContextMenu}"/>
                            <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <ListView Name="lvFinished" BorderThickness="0" Background="Transparent"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          GridViewColumnHeader.Click="lvFinished_Click">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="480">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Name">
                                        <TextBlock Text="{StaticResource SORT_NAME}"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                            <Border CornerRadius="6" Width="30" Height="30" Background="{StaticResource CategoryHighlight}" Margin="0,0,10,0">
                                                <Path Data="{Binding Path=Name, Converter={StaticResource FileExtensionToVectorImageConverter}}"
                                                      Fill="{StaticResource ListViewIconForecolor}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="130">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="DateAdded" Name="lvFinished_DateAdded">
                                        <TextBlock Text="{StaticResource SORT_DATE}"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DateAdded, StringFormat=d}" VerticalAlignment="Center" Foreground="{StaticResource ListViewHeaderForecolor}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="110" DisplayMemberBinding="{Binding Size, Converter={StaticResource FileSizeValueConverter}}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Size">
                                        <TextBlock Text="{StaticResource SORT_SIZE}"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="ContextMenu" Value="{StaticResource lvFinishedContextMenu}"/>
                            <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </DockPanel>
        <!--#endregion-->
    </Grid>
</Window>