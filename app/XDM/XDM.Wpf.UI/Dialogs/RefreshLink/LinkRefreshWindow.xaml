<Window x:Class="XDM.Wpf.UI.Dialogs.RefreshLink.LinkRefreshWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI.Dialogs.RefreshLink"
        mc:Ignorable="d"
        Title="{StaticResource MENU_REFRESH_LINK}" Height="180" Width="380" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True" Closing="Window_Closing"
        Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Height="6" Width="260" Margin="0,0,0,16"/>
            <TextBlock Text="{StaticResource REF_WAITING_FOR_LINK}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource ControlForecolor}" HorizontalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource ControlBackcolor}" BorderBrush="{StaticResource ToolbarBordercolor}" BorderThickness="0,1,0,0" Padding="16,12">
            <Button Name="BtnStop" Content="{StaticResource BTN_STOP_PROCESSING}" HorizontalAlignment="Right" Click="BtnStop_Click" Padding="16,6"/>
        </Border>
    </Grid>
</Window>