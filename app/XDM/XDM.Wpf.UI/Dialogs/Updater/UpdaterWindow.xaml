<Window x:Class="XDM.Wpf.UI.Dialogs.Updater.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI.Dialogs.Updater"
        mc:Ignorable="d"
        Title="{StaticResource OPT_UPDATE_FFMPEG}" Height="200" Width="440" WindowStartupLocation="CenterScreen"
        Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtHeading" Text="{StaticResource STAT_DOWNLOADING}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource ControlForecolor}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <ProgressBar Name="Prg" IsIndeterminate="False" Height="8" Width="320"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource ControlBackcolor}" BorderBrush="{StaticResource ToolbarBordercolor}" BorderThickness="0,1,0,0" Padding="16,12">
            <Button Name="BtnCancel" Content="{StaticResource ND_CANCEL}" HorizontalAlignment="Right" Padding="16,6"/>
        </Border>
    </Grid>
</Window>