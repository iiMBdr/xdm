<Window x:Class="XDM.Wpf.UI.Dialogs.BatchDownload.BatchDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI.Dialogs.BatchDownload"
        mc:Ignorable="d"
        Title="{StaticResource MENU_BATCH_DOWNLOAD}" Height="540" Width="640" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="TabControl" Margin="16,12">
            <TabItem Header="{StaticResource BAT_PATTERN}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{StaticResource LBL_BATCH_DESC}" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,14" FontSize="13" Foreground="{StaticResource ControlForecolor}"/>

                        <TextBlock Text="{StaticResource ND_ADDRESS}" Grid.Row="1" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtAddress" AcceptsReturn="False" TextWrapping="NoWrap" Grid.ColumnSpan="2" Grid.Column="1" Grid.Row="1" TextChanged="TxtAddress_TextChanged" Margin="0,0,0,10"/>

                        <TextBlock Text="{StaticResource LBL_BATCH_ASTERISK}" Grid.Row="2" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Margin="0,0,0,10"/>
                        <ComboBox x:Name="CmbType" Grid.Column="1" Grid.Row="2" SelectionChanged="CmbType_SelectionChanged" Margin="0,0,0,10">
                            <ComboBoxItem Content="{StaticResource LBL_BATCH_LETTER}"/>
                            <ComboBoxItem Content="{StaticResource LBL_BATCH_NUM}"/>
                        </ComboBox>

                        <TextBlock Text="{StaticResource LBL_BATCH_FROM}" Grid.Row="3" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Margin="0,0,0,10"/>
                        <ComboBox x:Name="CmbLetterFrom" Grid.Row="3" Grid.Column="1" SelectionChanged="CmbLetterFrom_SelectionChanged" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtNumberFrom" PreviewTextInput="TxtPreviewTextInput" DataObject.Pasting="TxtPasting" LostFocus="TxtLostFocus" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

                        <TextBlock Text="{StaticResource LBL_BATCH_TO}" Grid.Row="4" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Margin="0,0,0,10"/>
                        <ComboBox x:Name="CmbLetterTo" Grid.Row="4" Grid.Column="1" SelectionChanged="CmbLetterTo_SelectionChanged" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtNumberTo" PreviewTextInput="TxtPreviewTextInput" DataObject.Pasting="TxtPasting" LostFocus="TxtLostFocus" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>

                        <TextBlock Text="{StaticResource LBL_BATCH_FILE1}" Grid.Row="5" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtFile1" AcceptsReturn="False" TextWrapping="NoWrap" Grid.ColumnSpan="2" IsReadOnly="True" Grid.Column="1" Grid.Row="5" Margin="0,0,0,10"/>

                        <TextBlock Text="{StaticResource LBL_BATCH_FILE2}" Grid.Row="6" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtFile2" AcceptsReturn="False" TextWrapping="NoWrap" Grid.ColumnSpan="2" IsReadOnly="True" Grid.Column="1" Grid.Row="6" Margin="0,0,0,10"/>

                        <TextBlock Text="{StaticResource LBL_BATCH_FILEN}" Grid.Row="7" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtFileN" AcceptsReturn="False" TextWrapping="NoWrap" Grid.ColumnSpan="2" IsReadOnly="True" Grid.Column="1" Grid.Row="7" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkLeadingZero" Content="{StaticResource BAT_LEADING_ZERO}" Grid.Row="8" Checked="ChkLeadingZero_Checked" Unchecked="ChkLeadingZero_Unchecked" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtLeadingZero" PreviewTextInput="TxtPreviewTextInput" DataObject.Pasting="TxtPasting" LostFocus="TxtLostFocus" Grid.Row="8" Grid.Column="1"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{StaticResource BAT_LINKS}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{StaticResource BAT_PASTE_LINK}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource ControlForecolor}" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtDownloadLinks" Grid.Row="1" TextWrapping="NoWrap" AcceptsReturn="True"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{StaticResource ControlBackcolor}" BorderBrush="{StaticResource ToolbarBordercolor}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="{StaticResource ND_CANCEL}" Click="BtnCancel_Click" Padding="16,6" Margin="0,0,8,0"/>
                <Button x:Name="BtnOK" Content="{StaticResource MSG_OK}" Style="{StaticResource AccentButton}" Click="BtnOK_Click" Padding="18,6"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>