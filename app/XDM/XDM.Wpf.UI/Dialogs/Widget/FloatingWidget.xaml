<Window x:Class="XDM.Wpf.UI.Dialogs.Widget.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI.Dialogs.Widget"
        mc:Ignorable="d"
        Title="FloatingWidget" Height="42" Width="200" WindowStyle="None" MouseDown="Window_MouseDown"
        BorderThickness="0" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" Background="Transparent" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual">
    <Border CornerRadius="21" Background="#E60F1015" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Name="TxtHelp" Text="DOWNLOAD VIDEO" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
            <Path Grid.Column="1" Height="10" Width="10" VerticalAlignment="Center" Stretch="Uniform" Fill="#8E95A5" Data="{StaticResource ri-close-fill}" SnapsToDevicePixels="True" Margin="8,0,4,0" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>