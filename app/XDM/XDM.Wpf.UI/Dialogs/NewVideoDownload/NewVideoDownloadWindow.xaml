<Window x:Class="XDM.Wpf.UI.Dialogs.NewVideoDownload.NewVideoDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI.Dialogs.NewVideoDownload"
        mc:Ignorable="d"
        Title="{StaticResource ND_TITLE}" Height="280" Width="540" Topmost="True" WindowStartupLocation="CenterScreen"
        Closed="Window_Closed" ShowInTaskbar="False"
        Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}">
    <Window.Resources>
        <ContextMenu x:Key="DownloadLaterContextMenu"></ContextMenu>
        <MenuItem x:Key="DontAddToQueueMenuItem" Name="DontAddToQueueMenuItem" Header="{StaticResource LBL_QUEUE_OPT3}" Click="DontAddToQueueMenuItem_Click"/>
        <MenuItem x:Key="QueueAndSchedulerMenuItem" Name="QueueAndSchedulerMenuItem" Header="{StaticResource DESC_Q_TITLE}" Click="QueueAndSchedulerMenuItem_Click"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource LBL_NEW_QUEUE}" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="TxtFile" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource LBL_SAVE_IN}" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Name="CmbLocation" SelectionChanged="CmbLocation_SelectionChanged" Margin="0,0,0,10"/>

            <CheckBox Grid.Row="2" Grid.Column="1" Content="{StaticResource MSG_SAVE_AS_MP3}" Name="ChkMp3" Checked="ChkMp3_Checked" Unchecked="ChkMp3_Unchecked" Visibility="Collapsed" Margin="0,4,0,0"/>

            <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border CornerRadius="8" Width="40" Height="40" Background="{StaticResource CategoryHighlight}" Margin="0,0,0,6">
                    <Path Data="{StaticResource ri-movie-fill}" Fill="{StaticResource ListViewIconForecolor}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Name="TxtFileSize" Text="---" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource ListViewHeaderForecolor}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource ControlBackcolor}" BorderBrush="{StaticResource ToolbarBordercolor}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Name="btnAdvanced" Content="{StaticResource ND_MORE}" Click="btnAdvanced_Click" Padding="14,6"/>
                <Button Grid.Column="2" Name="btnDownloadLater" Content="{StaticResource ND_DOWNLOAD_LATER}" Click="btnDownloadLater_Click" Padding="14,6" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Name="btnDownload" Content="{StaticResource ND_DOWNLOAD_NOW}" Style="{StaticResource AccentButton}" Click="btnDownload_Click" Padding="18,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>