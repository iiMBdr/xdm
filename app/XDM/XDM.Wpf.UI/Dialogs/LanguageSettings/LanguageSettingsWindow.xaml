<Window x:Class="XDM.Wpf.UI.Dialogs.LanguageSettings.LanguageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI.Dialogs.LanguageSettings"
        mc:Ignorable="d"
        Title="{StaticResource MENU_LANG}" Height="220" Width="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="20" VerticalAlignment="Center">
            <TextBlock Text="{StaticResource MSG_LANG1}" FontSize="13" FontWeight="Medium" Margin="0,0,0,8" Foreground="{StaticResource ControlForecolor}"/>
            <ComboBox Name="CmbLanguage" Margin="0,0,0,12"/>
            <TextBlock Text="{StaticResource MSG_LANG2}" FontSize="11" Foreground="{StaticResource ListViewHeaderForecolor}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource ControlBackcolor}" BorderBrush="{StaticResource ToolbarBordercolor}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="BtnCancel" Content="{StaticResource ND_CANCEL}" Click="BtnCancel_Click" Padding="16,6" Margin="0,0,8,0"/>
                <Button Name="BtnOk" Content="{StaticResource MSG_OK}" Style="{StaticResource AccentButton}" Click="BtnOk_Click" Padding="18,6"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>