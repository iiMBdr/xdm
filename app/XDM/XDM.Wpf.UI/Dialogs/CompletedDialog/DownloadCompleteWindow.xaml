<Window x:Class="XDM.Wpf.UI.Dialogs.CompletedDialog.DownloadCompleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI.Dialogs.CompletedDialog"
        mc:Ignorable="d"
        Title="{StaticResource CD_TITLE}" Height="230" Width="480" WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" CornerRadius="10" Width="42" Height="42" Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Top" Margin="0,2,12,0">
                    <Path Data="{StaticResource ri-check-line}" Fill="#FFFFFF" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtFileName" Text="Filename" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ControlForecolor}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtLocation" Text="" Margin="0,4,0,12" FontSize="12" Foreground="{StaticResource ListViewHeaderForecolor}" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <Path Data="{StaticResource ri-drag-drop-line}" Fill="{StaticResource ListViewHeaderForecolor}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"/>
                    <TextBlock Text="Download Complete" FontSize="12" FontWeight="Medium" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource ControlBackcolor}" BorderBrush="{StaticResource ToolbarBordercolor}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="TxtDontShowCompleteDialog" MouseDown="TxtDontShowCompleteDialog_MouseDown"
                           Text="{StaticResource MSG_DONT_SHOW_AGAIN}" VerticalAlignment="Center" Cursor="Hand"
                           Foreground="{StaticResource HyperlinkForecolor}" FontSize="12" FontWeight="Medium"/>

                <Button Grid.Column="2" Name="BtnOpenFolder" Content="{StaticResource CTX_OPEN_FOLDER}" Click="BtnOpenFolder_Click" Padding="14,6" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Name="BtnOpen" Content="{StaticResource CTX_OPEN_FILE}" Style="{StaticResource AccentButton}" Click="BtnOpen_Click" Padding="18,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>