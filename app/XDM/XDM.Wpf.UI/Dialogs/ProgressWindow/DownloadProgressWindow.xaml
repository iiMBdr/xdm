<Window x:Class="XDM.Wpf.UI.Dialogs.ProgressWindow.DownloadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI.Dialogs.ProgressWindow"
        mc:Ignorable="d"
        Title="Download Progress" Height="300" Width="500" Closing="Window_Closing"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" CornerRadius="10" Width="42" Height="42" Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Top" Margin="0,2,12,0">
                    <Path Data="{StaticResource ri-file-download-fill}" Fill="#FFFFFF" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtFileName" Text="" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ControlForecolor}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtUrl" Text="---" Margin="0,2,0,12" FontSize="12" Foreground="{StaticResource ListViewHeaderForecolor}" TextTrimming="CharacterEllipsis"/>

                <!-- Status & Speed Header -->
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtStatus" Text="---" FontSize="13" FontWeight="Medium" Foreground="{StaticResource ControlForecolor}"/>
                    <TextBlock x:Name="TxtSpeed" Text="---" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Modern Progress Bar -->
                <ProgressBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="PrgProgress" Height="8" Margin="0,0,0,10"/>

                <!-- ETA & Speed Limit Footer -->
                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock x:Name="TxtETA" Text="" FontSize="12" Foreground="{StaticResource ListViewHeaderForecolor}"/>
                    <TextBlock x:Name="TxtSpeedLimit" Text="{StaticResource MSG_NO_SPEED_LIMIT}" FontSize="12"
                               HorizontalAlignment="Right" Foreground="{StaticResource HyperlinkForecolor}"
                               Cursor="Hand" MouseDown="TxtSpeedLimit_MouseDown" FontWeight="Medium"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource ControlBackcolor}" BorderBrush="{StaticResource ToolbarBordercolor}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="BtnHide" Content="{StaticResource DWN_HIDE}" Click="BtnHide_Click" Padding="14,6"/>
                <Button Grid.Column="2" Name="BtnStop" Content="{StaticResource BTN_STOP_PROCESSING}" Click="BtnStop_Click" Padding="14,6" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Name="BtnPause" Content="{StaticResource MENU_PAUSE}" Style="{StaticResource AccentButton}" Click="BtnPause_Click" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>