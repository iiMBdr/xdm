<Window x:Class="XDM.Wpf.UI.Dialogs.NewDownload.NewDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI.Dialogs.NewDownload"
        mc:Ignorable="d"
        Title="{StaticResource ND_TITLE}" Height="320" Width="580" Topmost="True" WindowStartupLocation="CenterScreen"
        Closed="Window_Closed" ShowInTaskbar="False"
        Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}">
    <Window.Resources>
        <ContextMenu x:Key="DownloadLaterContextMenu"></ContextMenu>
        <MenuItem x:Key="DontAddToQueueMenuItem" Header="{StaticResource LBL_QUEUE_OPT3}" Click="DontAddToQueueMenuItem_Click"/>
        <MenuItem x:Key="QueueAndSchedulerMenuItem" Header="{StaticResource DESC_Q_TITLE}" Click="QueueAndSchedulerMenuItem_Click"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource ND_ADDRESS}" VerticalAlignment="Center" Margin="0,8" FontWeight="Medium"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="TxtUrl" TextChanged="TxtUrl_TextChanged" Margin="0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource ND_FILE}" VerticalAlignment="Center" Margin="0,8" FontWeight="Medium"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="TxtFile" Margin="0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource LBL_SAVE_IN}" VerticalAlignment="Center" Margin="0,8" FontWeight="Medium"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Name="CmbLocation" SelectionChanged="CmbLocation_SelectionChanged" Margin="0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="1" Text="{StaticResource ND_IGNORE_URL}" Margin="0,12"
                           Cursor="Hand" MouseDown="TextBlock_MouseDown" Foreground="{StaticResource HyperlinkForecolor}" FontWeight="Medium"/>

                <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border CornerRadius="8" Width="40" Height="40" Background="{StaticResource CategoryHighlight}" Margin="0,0,0,6">
                        <Path Data="{StaticResource ri-file-download-line}" Fill="{StaticResource ListViewIconForecolor}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Name="TxtFileSize" Text="---" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource ListViewHeaderForecolor}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource ControlBackcolor}" BorderBrush="{StaticResource ToolbarBordercolor}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="btnAdvanced" Content="{StaticResource ND_MORE}" Click="btnAdvanced_Click" Padding="14,6"/>
                <Button Grid.Column="2" Name="btnDownloadLater" Content="{StaticResource ND_DOWNLOAD_LATER}" Click="btnDownloadLater_Click" Padding="14,6" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Name="btnDownload" Content="{StaticResource ND_DOWNLOAD_NOW}" Style="{StaticResource AccentButton}" Click="btnDownload_Click" Padding="18,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>