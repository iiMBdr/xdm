<Window x:Class="XDM.Wpf.UI.Dialogs.ChromeIntegrator.IntegrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI.Dialogs.ChromeIntegrator"
        mc:Ignorable="d" Topmost="True"
        Title="{StaticResource MSG_CHROME_INT}" Height="480" Width="680" WindowStartupLocation="CenterScreen" Closed="Window_Closed"
        Background="{StaticResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <local:Page0 x:Name="Page0"/>
            <local:Page1 x:Name="Page1"/>
            <local:Page2 x:Name="Page2"/>
            <local:Page3 x:Name="Page3"/>
            <local:Page4 x:Name="Page4"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource ControlBackcolor}" BorderBrush="{StaticResource ToolbarBordercolor}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{StaticResource MSG_HELP}" Name="BtnHelp" Click="BtnHelp_Click" Padding="14,6"/>
                <Button Grid.Column="2" Content="{StaticResource MSG_BACK}" Name="BtnBack" Click="BtnBack_Click" Padding="14,6" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="{StaticResource MSG_NEXT}" Name="BtnNext" Style="{StaticResource AccentButton}" Click="BtnNext_Click" Padding="18,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>