<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:core="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--#region Accent Colors & Dynamic Brushes -->
    <Color x:Key="AccentColor">#4F46E5</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3730A3"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#224F46E5"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F46E5" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>
    <!--#endregion-->

    <!--#region Navigation & Sidebar Brushes -->
    <SolidColorBrush x:Key="CategoryForegroundNormal" Color="#64748B"/>
    <SolidColorBrush x:Key="CategoryForegroundSelected" Color="#0F172A"/>
    <SolidColorBrush x:Key="CategoryHighlight" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="CategoryListBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CategoryMouseOverBackground" Color="#F1F5F9"/>
    <!--#endregion-->

    <!--#region Button Brushes -->
    <SolidColorBrush x:Key="ButtonBackcolor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonForecolor" Color="#0F172A"/>
    <SolidColorBrush x:Key="ButtonMouseOverBackcolor" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ButtonMousePressedBackcolor" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ButtonDisabledBackcolor" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ButtonFocusedBorder" Color="#4F46E5"/>
    <SolidColorBrush x:Key="ButtonOverBackcolor" Color="#F8FAFC"/>

    <SolidColorBrush x:Key="ToolButtonForecolor" Color="#64748B"/>
    <SolidColorBrush x:Key="ToolButtonMouseOverBackcolor" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ToolButtonMousePressedBackcolor" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ToolButtonMouseDisabledForecolor" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ToolbarBordercolor" Color="#E2E8F0"/>
    <!--#endregion-->

    <!--#region Search & Input Brushes -->
    <SolidColorBrush x:Key="SearchBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="SearchBackcolor" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ControlBackcolor" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ControlBordercolor" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ControlForecolor" Color="#0F172A"/>

    <SolidColorBrush x:Key="TextBackcolor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextForecolor" Color="#0F172A"/>
    <SolidColorBrush x:Key="DisabledTextBackcolor" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextMouseOverBorder" Color="#4F46E5"/>
    <SolidColorBrush x:Key="TextBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextFocusedBorder" Color="#4F46E5"/>
    <!--#endregion-->

    <!--#region List & Card Brushes -->
    <SolidColorBrush x:Key="ListViewBackcolor" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ListViewCardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ListViewForecolor" Color="#334155"/>
    <SolidColorBrush x:Key="ListViewMouseOverBackcolor" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ListViewMouseOverForecolor" Color="#0F172A"/>
    <SolidColorBrush x:Key="ListViewSelectedForecolor" Color="#0F172A"/>
    <SolidColorBrush x:Key="ListViewSelectedBackcolor" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ListViewIconForecolor" Color="#6366F1"/>
    <SolidColorBrush x:Key="ListViewHeaderForecolor" Color="#64748B"/>
    <!--#endregion-->

    <!--#region Status & Misc Brushes -->
    <SolidColorBrush x:Key="StatusbarBackcolor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StatusbarIconcolor" Color="#4F46E5"/>

    <Thickness x:Key="CategoryListBorderThickness">0</Thickness>
    <Thickness x:Key="MainContentBorderThickness">0,1,0,0</Thickness>

    <SolidColorBrush x:Key="PlaceHolderForecolor" Color="#94A3B8"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey }" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey }" Color="#4F46E5"/>

    <SolidColorBrush x:Key="NewDownloadTextBoxBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HyperlinkForecolor" Color="#4F46E5"/>

    <SolidColorBrush x:Key="ScrollBarThumbColorNormal" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ScrollBarThumbColorHot" Color="#94A3B8"/>

    <SolidColorBrush x:Key="ControlDisabledBackcolor" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TabSelectionColor" Color="#4F46E5"/>

    <SolidColorBrush x:Key="ProgressBarBackcolor" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ProgressBarForecolor" Color="#4F46E5"/>

    <core:Double x:Key="ButtonDisabledOpacity">0.5</core:Double>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource ControlForecolor}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Inter, -apple-system, SF Pro Text, sans-serif"/>
    </Style>
</ResourceDictionary>