<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:core="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--#region Accent Colors & Dynamic Brushes -->
    <Color x:Key="AccentColor">#00F0FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#00F0FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#33F3FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#00C4D4"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#4400F0FF"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#050B14"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F0FF" Offset="0"/>
        <GradientStop Color="#D946EF" Offset="1"/>
    </LinearGradientBrush>
    <!--#endregion-->

    <!--#region Navigation & Sidebar Brushes -->
    <SolidColorBrush x:Key="CategoryForegroundNormal" Color="#8B9BB4"/>
    <SolidColorBrush x:Key="CategoryForegroundSelected" Color="#00F0FF"/>
    <SolidColorBrush x:Key="CategoryHighlight" Color="#1A2234"/>
    <SolidColorBrush x:Key="CategoryListBackground" Color="#0B0D14"/>
    <SolidColorBrush x:Key="CategoryMouseOverBackground" Color="#141926"/>
    <!--#endregion-->

    <!--#region Button Brushes -->
    <SolidColorBrush x:Key="ButtonBackcolor" Color="#121622"/>
    <SolidColorBrush x:Key="ButtonForecolor" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ButtonMouseOverBackcolor" Color="#1D2436"/>
    <SolidColorBrush x:Key="ButtonMousePressedBackcolor" Color="#0E121C"/>
    <SolidColorBrush x:Key="ButtonDisabledBackcolor" Color="#0B0E17"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#222B3E"/>
    <SolidColorBrush x:Key="ButtonFocusedBorder" Color="#00F0FF"/>
    <SolidColorBrush x:Key="ButtonOverBackcolor" Color="#1A2234"/>

    <SolidColorBrush x:Key="ToolButtonForecolor" Color="#8B9BB4"/>
    <SolidColorBrush x:Key="ToolButtonMouseOverBackcolor" Color="#1A2234"/>
    <SolidColorBrush x:Key="ToolButtonMousePressedBackcolor" Color="#121622"/>
    <SolidColorBrush x:Key="ToolButtonMouseDisabledForecolor" Color="#475569"/>
    <SolidColorBrush x:Key="ToolbarBordercolor" Color="#182030"/>
    <!--#endregion-->

    <!--#region Search & Input Brushes -->
    <SolidColorBrush x:Key="SearchBorder" Color="#222B3E"/>
    <SolidColorBrush x:Key="SearchBackcolor" Color="#0E121C"/>

    <SolidColorBrush x:Key="ControlBackcolor" Color="#0E121C"/>
    <SolidColorBrush x:Key="ControlBordercolor" Color="#182030"/>
    <SolidColorBrush x:Key="ControlForecolor" Color="#E2E8F0"/>

    <SolidColorBrush x:Key="TextBackcolor" Color="#0E121C"/>
    <SolidColorBrush x:Key="TextForecolor" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="DisabledTextBackcolor" Color="#0A0D14"/>
    <SolidColorBrush x:Key="TextMouseOverBorder" Color="#00F0FF"/>
    <SolidColorBrush x:Key="TextBorder" Color="#222B3E"/>
    <SolidColorBrush x:Key="TextFocusedBorder" Color="#00F0FF"/>
    <!--#endregion-->

    <!--#region List & Card Brushes -->
    <SolidColorBrush x:Key="ListViewBackcolor" Color="#07090F"/>
    <SolidColorBrush x:Key="ListViewCardBackground" Color="#121622"/>
    <SolidColorBrush x:Key="ListViewForecolor" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ListViewMouseOverBackcolor" Color="#1A2234"/>
    <SolidColorBrush x:Key="ListViewMouseOverForecolor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ListViewSelectedForecolor" Color="#00F0FF"/>
    <SolidColorBrush x:Key="ListViewSelectedBackcolor" Color="#1D2A40"/>
    <SolidColorBrush x:Key="ListViewIconForecolor" Color="#00F0FF"/>
    <SolidColorBrush x:Key="ListViewHeaderForecolor" Color="#64748B"/>
    <!--#endregion-->

    <!--#region Status & Misc Brushes -->
    <SolidColorBrush x:Key="StatusbarBackcolor" Color="#07090F"/>
    <SolidColorBrush x:Key="StatusbarIconcolor" Color="#00F0FF"/>

    <Thickness x:Key="CategoryListBorderThickness">0,0,1,0</Thickness>
    <Thickness x:Key="MainContentBorderThickness">0</Thickness>

    <SolidColorBrush x:Key="PlaceHolderForecolor" Color="#64748B"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey }" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey }" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey }" Color="#07090F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey }" Color="#00F0FF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextColorKey }" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="NewDownloadTextBoxBackground" Color="#0E121C"/>
    <SolidColorBrush x:Key="HyperlinkForecolor" Color="#00F0FF"/>

    <SolidColorBrush x:Key="ScrollBarThumbColorNormal" Color="#222B3E"/>
    <SolidColorBrush x:Key="ScrollBarThumbColorHot" Color="#33415E"/>

    <SolidColorBrush x:Key="ControlDisabledBackcolor" Color="#07090F"/>
    <SolidColorBrush x:Key="TabSelectionColor" Color="#00F0FF"/>

    <SolidColorBrush x:Key="ProgressBarBackcolor" Color="#121622"/>
    <SolidColorBrush x:Key="ProgressBarForecolor" Color="#00F0FF"/>

    <core:Double x:Key="ButtonDisabledOpacity">0.4</core:Double>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource ControlForecolor}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Inter, -apple-system, SF Pro Text, sans-serif"/>
    </Style>
</ResourceDictionary>